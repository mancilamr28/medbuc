# Copiază în .env.local (ignorat de git) și pune valorile reale acolo.

# DSN-ul de Sentry — vezi Settings > Client Keys (DSN) în proiectul Sentry.
# Opțional: fără el, aplicația rulează normal, doar fără raportare de erori.
VITE_SENTRY_DSN=

# Proiectul Supabase — vezi Settings > API în dashboard.
# Ambele obligatorii de la Faza 3 încolo.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
